{
  "name": "cytoscape-cxtmenu",
  "version": "3.6.0",
  "description": "A circular, swipeable context menu extension for Cytoscape.js",
  "main": "cytoscape-cxtmenu.js",
  "module": "src/index.js",
  "author": {
    "name": "Max Franz",
    "email": "maxkfranz@gmail.com"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:min": "npm run test:cytoscape -- 3.2.0",
    "test:latest": "npm run test:cytoscape -- 3.34.0",
    "test:cytoscape": "node scripts/test-cytoscape.js",
    "lint": "eslint .",
    "build": "cross-env NODE_ENV=production webpack",
    "build:min": "cross-env NODE_ENV=production MIN=true webpack",
    "build:release": "npm-run-all2 build copyright",
    "copyright": "node scripts/update-license.js",
    "watch": "webpack --watch",
    "dev": "webpack serve --open",
    "clean": "rimraf coverage"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cytoscape/cytoscape.js-cxtmenu.git"
  },
  "keywords": [
    "cytoscape",
    "cytoscape-extension"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cytoscape/cytoscape.js-cxtmenu/issues"
  },
  "homepage": "https://github.com/cytoscape/cytoscape.js-cxtmenu",
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "babel-loader": "^10.1.1",
    "chai": "^6.2.2",
    "cpy-cli": "^7.0.0",
    "cross-env": "^10.1.0",
    "cytoscape": "3.34.0",
    "eslint": "^10.8.0",
    "gh-pages": "^6.3.0",
    "globals": "^17.11.0",
    "mocha": "^11.7.6",
    "npm-run-all2": "^9.0.3",
    "rimraf": "^6.1.3",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.1",
    "webpack-dev-server": "^6.0.0"
  },
  "peerDependencies": {
    "cytoscape": "^3.2.0"
  }
}
